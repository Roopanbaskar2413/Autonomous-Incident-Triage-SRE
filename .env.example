OPENAI_API_KEY=sk-your-key-here

# Optional: LangSmith tracing (https://smith.langchain.com). Traces the
# LangGraph run automatically via these env vars alone — no code changes
# needed. Leave LANGCHAIN_TRACING_V2 unset/false to disable.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=incident-triage-sre
